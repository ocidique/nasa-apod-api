# NASA API Configuration
NASA_API_KEY=DEMO_KEY

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Mock Mode (set to true for testing without NASA API access)
USE_MOCK=false

# Caching Strategy Configuration
# Since APODs are historical JSON data (immutable, small size), we cache aggressively
# CACHE_TTL_RECENT: Cache duration for recent APODs (0 = indefinite)
CACHE_TTL_RECENT=0
# CACHE_TTL_HISTORICAL: Cache duration in days for historical APODs
CACHE_TTL_HISTORICAL=365
# CACHE_RECENT_DAYS_THRESHOLD: Number of days to consider an APOD "recent"
CACHE_RECENT_DAYS_THRESHOLD=7
